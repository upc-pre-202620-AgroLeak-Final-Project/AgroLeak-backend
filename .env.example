# DEV local only. Export through your shell or IDE; Spring does not auto-load .env.
SPRING_PROFILES_ACTIVE=dev
PORT=8081
DB_URL=jdbc:postgresql://localhost:5433/agroleak
DB_USERNAME=agroleak
DB_PASSWORD=agroleak
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173
DEMO_DATA_ENABLED=true
# Set an external JWT_SECRET (at least 32 bytes) to keep tokens across restarts.
# PROD requires DB_URL, DB_USERNAME, DB_PASSWORD, JWT_SECRET, CORS_ALLOWED_ORIGINS.

# Academic presentation account: DEV only by default; PROD requires explicit opt-in.
PRESENTATION_DATA_ENABLED=true
